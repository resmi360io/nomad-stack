# Affiliate IDs — replace before launch
# WISE_AFFILIATE_ID=
# REVOLUT_AFFILIATE_ID=
# PAYONEER_AFFILIATE_ID=
# PAYPAL_AFFILIATE_ID=
# GRABRFI_AFFILIATE_ID=
