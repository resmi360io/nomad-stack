# Site URL (set to your custom domain once registered; used in sitemap/robots)
# NEXT_PUBLIC_SITE_URL=https://paidacross.com

# PostHog analytics (https://posthog.com — free tier supports custom events)
# Get your project API key from posthog.com → Project Settings → Project API key
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com for EU cloud
